// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Gift {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Float    // Valor unitário ou valor da cota individual
  totalPrice  Float?   // Valor total original do produto (ex: 2000.00)
  imageUrl    String
  category    String   @default("Sala de Estar") // Cômodo da casa
  
  // Sistema de Cotas
  isQuota     Boolean  @default(false)
  totalQuotas Int      @default(1)     // Quantidade total de cotas (ex: 4)
  paidQuotas  Int      @default(0)     // Quantidade de cotas já adquiridas
  
  status      String   @default("AVAILABLE") // AVAILABLE, RESERVED, GIFTED
  reservedBy  String?
  message     String?
  createdAt   DateTime @default(now())
}